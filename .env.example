# MagicalGirlWebOracle environment configuration
# Copy to .env and fill in what you have. Missing keys => provider auto-marked unavailable.
# NEVER commit the real .env. Keys must not appear in code/README/logs/tests/git history.

# ---- Paid-tier API keys (all OPTIONAL; used strictly within free quotas) ----
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=

# You.com free MCP is keyless by default; set YDC_API_KEY only if you want the
# authenticated (higher-limit) profile. Leave empty to stay on the free profile.
YDC_API_KEY=

# ---- Self-hosted services (optional) ----
# SearXNG instance, e.g. http://192.168.1.10:8888
SEARXNG_URL=
# Crawl4AI instance, e.g. http://192.168.1.10:11235
CRAWL4AI_URL=
# Crawl4AI docker-deploy token (optional, depends on your deployment)
CRAWL4AI_TOKEN=

# ---- Network ----
# Outbound proxy for external providers (Exa/Tavily/Firecrawl/Jina/You.com).
# Self-hosted SearXNG/Crawl4AI services bypass it automatically.
# Falls back to HTTPS_PROXY / HTTP_PROXY if unset.
PROXY_URL=

# ---- Behavior ----
# HARD RULE: never allow paid overage. Keep false.
ALLOW_PAID_OVERAGE=false

# Default search mode: fast | auto | high | max
SEARCH_MODE_DEFAULT=auto

# Usage DB path (SQLite). Relative to project root or absolute.
USAGE_DB_PATH=data/usage.sqlite3

# Store raw query text in usage DB? false => only a salted hash.
STORE_QUERY_TEXT=false
QUERY_HASH_SALT=

# Optional: Jina is free keyless at low rate; set true to call r.jina.ai without a key.
JINA_KEYLESS_FALLBACK=true

# ---- MCP transport ----
# stdio            = Agent spawns the server locally (single machine, default)
# streamable-http  = shared Oracle on a trusted host; several machines share one ledger
# sse              = legacy HTTP transport for older clients
MCP_TRANSPORT=stdio
# Bind address for direct (non-Docker) HTTP runs. Loopback is the safe default;
# expose 0.0.0.0 only when you also set MCP_AUTH_TOKEN.
# MCP_HOST=127.0.0.1
MCP_PORT=28288
MCP_PATH=/mcp
# Which host interface docker compose publishes:
#   127.0.0.1 = local only (default, safe)
#   0.0.0.0   = all interfaces (LAN/VPN); deploy.sh does this for you
#   <ip>      = pin to one interface, e.g. a WireGuard address
MCP_BIND_IP=127.0.0.1
# Shared secret for HTTP mode. Strongly recommended when binding 0.0.0.0.
# Clients then send: Authorization: Bearer <token>
# Leave empty only on a fully trusted machine.
MCP_AUTH_TOKEN=

# ---- Multi-account quota dashboard (opt-in) ----
# Secret-free YAML. For Docker, keep it under the existing data volume.
ORACLE_ACCOUNTS_FILE=
# Independent admin bearer token. Empty disables /admin/ and its API.
# Must differ from MCP_AUTH_TOKEN; use HTTPS when accessing over a network.
ORACLE_ADMIN_TOKEN=
# Optional Fernet master key for encrypted Web Key management. Keep it separate
# from the database/volume, back it up securely, and never regenerate on restart.
# Empty => Web credential writes disabled (unless encrypted state already exists,
# in which case startup fails closed until the original master key is restored).
ORACLE_VAULT_KEY=
# Optional independent HTTPS management listener (admin.tls_server). The admin
# service shares the ledger with MCP and does not expose /mcp.
# Publish it on loopback by default; use a VPN or authenticated proxy for remote access.
ORACLE_ADMIN_BIND_IP=127.0.0.1
ORACLE_ADMIN_HTTPS_PORT=28443
ORACLE_ADMIN_TLS_CERT=/app/data/private/tls/cert.pem
ORACLE_ADMIN_TLS_KEY=/app/data/private/tls/key.pem

# Optional second-account credentials referenced by config/accounts*.example.yaml.
# Prefer adding keys through the admin UI (stored encrypted in the ledger) over .env.
TAVILY_API_KEY_SECOND=
YDC_API_KEY_SECOND=
JINA_API_KEY_SECOND=

# Background official balance sync in explicit multi-key mode: 300 seconds default.
# Allowed: 0 (disable outbound sync, keep station monitoring), or 60..480.
ORACLE_BALANCE_SYNC_INTERVAL=300
# Low-budget warning ratio: finite number in [0, 1]; 0 disables this threshold.
ORACLE_LOW_QUOTA_RATIO=0.1

# ---- Stage 4: opt-in cache and explainable scheduling ----
# Response cache is a separate SQLite file; 0 disables it and preserves the
# pre-cache behavior. When search cache is enabled, fetch defaults to 3600s.
ORACLE_CACHE_TTL_SECONDS=0
ORACLE_FETCH_CACHE_TTL_SECONDS=3600
ORACLE_CACHE_MAX_ENTRIES=500
# Optional path; default is cache.sqlite3 next to USAGE_DB_PATH.
ORACLE_CACHE_PATH=
# priority (default) | balanced | expiry | preferred_account
ORACLE_SCHEDULING_STRATEGY=priority
# Required only for preferred_account; use the internal account id.
ORACLE_PREFERRED_ACCOUNT=
